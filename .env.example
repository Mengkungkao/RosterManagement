# Copy to .env.local and fill in. See README.md, "Setup".

# Google Sheets (service account) — server only, never sent to the browser
GOOGLE_SERVICE_ACCOUNT_EMAIL=roster@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-part-of-the-sheet-url-between-/d/-and-/edit

# Tab names (optional — these are the defaults; missing tabs are created on first save)
GOOGLE_SHEET_TAB=Availability
GOOGLE_EVENTS_SHEET_TAB=Events
GOOGLE_ROSTER_SHEET_TAB=Roster
GOOGLE_SETTINGS_SHEET_TAB=Settings
GOOGLE_TASK_TYPES_SHEET_TAB=Task Types
GOOGLE_SKILLS_SHEET_TAB=Skills
GOOGLE_TEMPLATES_SHEET_TAB=Templates

# Admin access to /admin. Prefer a hash (npm run hash-password); a plain
# ADMIN_PASSWORD still works. If both are set, the hash is used.
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
ADMIN_PASSWORD=choose-a-password
# Random long string used to sign the admin session cookie: openssl rand -hex 32
# (changing it, or the admin password, signs everyone out)
AUTH_SECRET=

# Optional: use a local JSON file instead of Google Sheets (demos, testing).
# ROSTER_LOCAL_DATA=/path/to/roster-data.json
